// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "height": 22,
    "spacing": 0,

    "modules-left": [
        "niri/workspaces",
        "niri/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "custom/heymail",
        "custom/voxtype",
        "backlight",
        "wireplumber",
        "cpu",
        "battery",
        "custom/sysmenu"
    ],

    "niri/workspaces": {
        "format": "{value}",
        "disable-click": false
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 28,
        "separate-outputs": true
    },

    "clock": {
        // Mismo formato que `tuigreet --time` (ej: "lun, 23 nov 2026 - 22:13")
        "format": "{:%a, %d %b %Y - %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "on-click": "$HOME/.local/bin/calendar-menu",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffffff'><b>{}</b></span>",
                "days": "<span color='#cccccc'>{}</span>",
                "weekdays": "<span color='#888888'><b>{}</b></span>",
                "today": "<span background='#cccccc' color='#000000'><b>{}</b></span>"
            }
        }
    },

    "tray": {
        "icon-size": 14,
        "spacing": 6
    },

    "custom/heymail": {
        "exec": "$HOME/.local/bin/heymail-waybar status",
        "return-type": "json",
        "interval": 60,
        "signal": 8,
        "tooltip": true,
        "on-click": "$HOME/.local/bin/heymail-waybar --menu",
        "on-click-right": "$HOME/.local/bin/heymail-waybar --pwa"
    },

    "custom/voxtype": {
        "exec": "voxtype status --follow --format json",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "idle": "",
            "recording": " REC",
            "transcribing": " ...",
            "stopped": ""
        },
        "tooltip": true,
        "on-click": "voxtype record toggle",
        "on-click-right": "systemctl --user restart voxtype"
    },

    "backlight": {
        "device": "intel_backlight",
        "format": " {percent}%",
        "on-scroll-up": "$HOME/.local/bin/osd brightness-up",
        "on-scroll-down": "$HOME/.local/bin/osd brightness-down",
        "tooltip-format": "Brillo: {percent}%"
    },

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": " MUTE",
        "format-icons": ["", "", ""],
        "on-click": "$HOME/.local/bin/osd vol-mute",
        "on-click-right": "$HOME/.local/bin/sysmenu audio",
        "on-scroll-up": "$HOME/.local/bin/osd vol-up",
        "on-scroll-down": "$HOME/.local/bin/osd vol-down",
        "tooltip-format": "{node_name}: {volume}%"
    },

    "cpu": {
        "interval": 3,
        "format": " {usage}%",
        "tooltip": true,
        "on-click": "foot -T btop -a btop btop"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-full": " 100%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo}\nConsumo: {power:.1f}W"
    },

    "custom/sysmenu": {
        "format": "",
        "tooltip-format": "Menú de sistema (Mod+S): Wi-Fi, Bluetooth, Audio...",
        "on-click": "$HOME/.local/bin/sysmenu"
    }
}
