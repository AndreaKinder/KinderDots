// Programas al inicio de sesión

spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "/usr/lib/mate-polkit/polkit-mate-authentication-agent-1"
spawn-sh-at-startup "swaybg -m fill -i \"$HOME/Imágenes/Wallpapers/06-kinder-midnight-oled.png\""

// Portapapeles persistente + historial
spawn-at-startup "wl-clip-persist" "--clipboard" "regular"
spawn-sh-at-startup "wl-paste --type text --watch cliphist store"
spawn-sh-at-startup "wl-paste --type image --watch cliphist store"

// Bloqueo e inactividad (5 min bloqueo, 10 min apagar pantalla, bloqueo al suspender)
spawn-sh-at-startup "swayidle -w timeout 300 'swaylock -f' timeout 600 'niri msg action power-off-monitors' before-sleep 'swaylock -f'"
